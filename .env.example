# Copy to `.env` in the project root and fill in your own values.
# `.env` is git-ignored and is NEVER bundled as a Flutter asset: the build
# script (tool/build_with_env.ps1) reads it and forwards each entry to the Dart
# compiler as a --dart-define.
#
#   Copy-Item .env.example .env
#   .\tool\build_with_env.ps1
#
# Warning: a compiled binary CONTAINS the injected value, because a
# --dart-define is a compile-time constant. Treat any shipped APK/IPA as a
# secret-bearing artifact and never distribute one that carries a personal key.

# TMDB API key (v3 key or v4 read access token).
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
