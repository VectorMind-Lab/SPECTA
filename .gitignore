# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.iml

# Secrets — NEVER commit these.
# `.env` holds the developer's TMDB API key. It is read at BUILD time only and
# converted into a `--dart-define`, so the value reaches the compiler and never
# becomes a bundled Flutter asset. This file must stay untracked.
.env
.env.*
!.env.example
*.pem
*.p12

# Android local state (contains build artifacts, generated Kotlin error logs)
android/.gradle/
android/local.properties
android/key.properties
android/.kotlin/
android/captures/
*.jks
*.keystore

# OS noise
.DS_Store
Thumbs.db

# Build outputs
build/
apk_build.log
android/.kotlin/errors/errors-*.log

# Generated code is checked in for now (see docs/PROJECT_STATE.txt) so that a
# fresh clone can be analysed without running build_runner first.
# Uncomment the next line to keep drift output out of git instead.
# **/*.g.dart
