<?xml version="1.0" encoding="utf-8"?>
<!-- API 21+ variant. Kept identical in effect to drawable/launch_background.xml:
     SPECTA's canvas colour, with the brand mark centred. See that file for why
     the stock white background was replaced. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/specta_launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/specta_launch_icon" />
    </item>
</layer-list>
